# Supabase (NEXT_PUBLIC_ vars are exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID=your-google-client-id

# Groq (LLM for questions, evaluation, resume analysis)
GROQ_API_KEY=your-groq-api-key

# Google Gemini (LLM fallback when Groq is unavailable)
GEMINI_API_KEY=your-gemini-api-key

# Sarvam AI (primary TTS — Bulbul Indian English/Hinglish voices —
# AND fallback STT — Hinglish code-switching). One key, both endpoints.
SARVAM_API_KEY=your-sarvam-api-key

# Cartesia TTS (2nd-tier text-to-speech — low-latency PCM streaming)
CARTESIA_API_KEY=your-cartesia-api-key

# Azure TTS (3rd-tier text-to-speech — Indian English neural voices)
AZURE_TTS_KEY=your-azure-cognitive-services-key
AZURE_TTS_REGION=centralindia

# Deepgram (primary speech-to-text — Nova-3 with multi-language)
DEEPGRAM_API_KEY=your-deepgram-api-key
# DEEPGRAM_PROJECT_ID=your-deepgram-project-id  # required to mint scoped STT tokens; unset ⇒ STT 503s

# ── Voice cost policy ──────────────────────────────────────────────────
# Paid voice (Sarvam TTS, Deepgram/Sarvam STT) is a paying-tier benefit by
# DEFAULT — free users fall back to the zero-cost browser Web Speech chain.
# Set VOICE_FREE_TIER=1 to also grant paid voice to free users.
# VOICE_FREE_TIER=0
# SARVAM_TTS_FREE_DISABLED=1   # legacy hard kill switch for Sarvam TTS on free tier

# Sarvam STT client-side enable flag.
# Sarvam has no scoped-key API, so enabling this hands the master API key to
# the browser (visible in DevTools WebSocket headers). The per-user daily cap
# (30 token issuances) and auth requirement limit the blast radius, but a user
# who captures the key can call Sarvam directly. Set to "true" to enable the
# Deepgram → Sarvam fallback chain; leave unset to fall back to Web Speech API.
SARVAM_ALLOW_CLIENT_KEY=true
# LLM_USAGE_RETENTION_DAYS=30  # prune-llm-usage cron deletes raw rows older than this (min 7)

# Razorpay (payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# PostHog (product analytics — gated behind cookie consent).
# REQUIRED in every deployed environment or ZERO events are captured —
# initPostHog() silently no-ops when the key is missing (it warns on
# non-production builds). Set this in the Vercel project's Environment
# Variables for Production AND Preview.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App URL (used in email links, required for production)
APP_URL=https://levelup-taupe.vercel.app

# Resend (payment confirmation emails + session report notifications)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=HireStepX <hello@hirestepx.com>

# Upstash Redis (persistent rate limiting, optional — falls back to in-memory)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cron job secret (protects /api/send-renewal-reminders)
# CRON_SECRET=your-random-secret

# CORS (comma-separated production domains, optional).
# Add your Vercel preview URLs here — the wildcard *.vercel.app is intentionally NOT
# allowed; only the current deployment's VERCEL_URL (set automatically by Vercel) passes.
# ALLOWED_ORIGINS=https://hirestepx.com,https://levelup-taupe.vercel.app

# Sentry (error monitoring — set in Vercel to capture production exceptions)
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0

# Quota / session-limit fail behaviour under Supabase/Redis outage.
# Default (0) = fail-open: paid users stay unblocked during transient errors.
# Set to 1 in production only if you'd rather lock everyone than risk abuse during incidents.
# QUOTA_FAIL_CLOSED=0
# SESSION_LIMIT_FAIL_CLOSED=0

# Admin panel secret (admin.hirestepx.com). Required — admin login page is fail-closed without it.
# ADMIN_PASSWORD=your-strong-admin-password
# ADMIN_SESSION_SECRET=your-hmac-signing-secret-32-chars-min
