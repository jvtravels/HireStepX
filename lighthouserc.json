{
  "_comment": "Lighthouse CI against PRODUCTION (mobile, simulated slow 4G + 4x CPU). Run weekly by .github/workflows/lighthouse.yml. Baselines measured 2026-10-10: perf 71-74, LCP 5.0-7.4s, CLS 0-0.097, TBT 160-210ms, a11y/best-practices/seo 100. 'error' assertions are regression guards set just below the measured baseline; 'warn' assertions are the aspirational targets. Ratchet the guards up as perf improves.",
  "ci": {
    "collect": {
      "url": [
        "https://hirestepx.com/",
        "https://hirestepx.com/pricing",
        "https://hirestepx.com/login"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.6 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.15 }],
        "total-blocking-time": ["error", { "maxNumericValue": 400 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 9000 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "interactive": ["warn", { "maxNumericValue": 3500 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
