# NOTE: data/_imported-salary-overrides.generated.ts is intentionally
# tracked in git — it's imported by company-salary-overrides.ts at runtime
# and we want CI/Vercel builds to use the latest committed version without
# re-running the scraper. Re-emit via `npm run import:salaries -- --emit`.

