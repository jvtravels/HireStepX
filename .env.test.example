# Copy to .env.test (gitignored) and fill in real values from the
# TEST/staging Supabase project. Never point these at production.

# Playwright base URL — defaults to localhost:3000 in playwright.config.ts.
# Override in CI to point at a staging deploy if desired.
BASE_URL=http://localhost:3000

# Stable test user provisioned in the TEST Supabase project. The user must
# already have a profiles row and have completed onboarding so authed specs
# don't get bounced to /onboarding. Used by tests/helpers/auth.ts.
TEST_USER_EMAIL=<your-test-user-email>
TEST_USER_PASSWORD=<your-test-user-password>

# Test-project Supabase. Anon key is the same one the app ships with;
# service-role key is used by tests/helpers/api.ts for seeding + cleanup
# (bypasses RLS). Never put a production service-role key here.
SUPABASE_URL=https://<your-test-project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Razorpay test-mode (keys starting with rzp_test_...). Required by P0
# payment specs. The webhook secret matches the test-mode webhook
# endpoint configured in the Razorpay test dashboard.
RAZORPAY_KEY_ID=rzp_test_<your-test-key>
RAZORPAY_KEY_SECRET=<your-test-secret>
RAZORPAY_WEBHOOK_SECRET=<your-test-webhook-secret>
